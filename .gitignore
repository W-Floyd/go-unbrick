# Never commit firmware. This repo is the tool; point it at your own files.
*.bin
*.img
*.elf
*.mbn
*.zip
*.pdf
work/
out/
donor/
target/

# Build artifacts
/bfforge
/blankflash-forge
/go-unbrick
*.test

# Local firmware library (blankflashes + stock). The catalog/ mapping IS tracked.
# Keep the folder skeleton (.gitkeep) but never the firmware inside.
/library/**
!/library/**/
!/library/**/.gitkeep
